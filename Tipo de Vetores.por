programa {
  funcao inicio() {
    inteiro notas[5]
    real alturas[10]
    cadeia nomes[3]
    logico respostas[4]

    // Atribuindo valores individualmente

    nomes[0] = "Cauê"
    nomes[1] = "Bruno"
    nomes[2] = "Rafael"

    notas[0] = 4
    notas[1] = 5
    notas[2] = 6
    notas[3] = 7
    notas[4] = 8
    notas[5] = 9

    alturas[0] = 1.0
    alturas[1] = 2.0
    alturas[2] = 3.0
    alturas[3] = 4.0
    alturas[5] = 5.0
    alturas[6] = 6.0
    alturas[7] = 7.0
    alturas[8] = 8.0
    alturas[9] = 9.0
    alturas[10] = 10.0

    respostas[0] = verdadeiro
    respostas[1] = falso
    respostas[2] = verdadeiro
    respostas[3] = falso

    escreva(nomes[0])
    escreva(nomes[1])
    escreva(nomes[2])

    escreva(notas[0])
    escreva(notas[1])
    escreva(notas[2])
    escreva(notas[3])
    escreva(notas[4])
    escreva(notas[5])

    escreva(alturas[0])
    escreva(alturas[1])
    escreva(alturas[2])
    escreva(alturas[3])
    escreva(alturas[4])
    escreva(alturas[5])
    escreva(alturas[6])
    escreva(alturas[7])
    escreva(alturas[8])
    escreva(alturas[9])
    escreva(alturas[10])

    escreva(respostas[0])
    escreva(respostas[1])
    escreva(respostas[2])
    escreva(respostas[3])
    escreva(respostas[4])
  }
}
