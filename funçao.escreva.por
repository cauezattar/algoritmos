programa {
  funcao inicio() {
    cadeia nome
    inteiro pontos,idade

    nome = "Cauê F."
    pontos = 1500
    idade = 15
    escreva("Olá, mundo! \n")
    escreva(nome," tem ", idade, " de idade\n")
    escreva("Meu amigo ganhou", pontos, " e o outro amigo tem ", idade," de idade e o meu nome e ", nome," e fim")
  }
}
