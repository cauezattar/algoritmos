programa {
  funcao inicio() {
    inteiro numeros [5]

    numeros[0] = 10 // primeira posição
    numeros[1] = 20 // segunda posição
    numeros[2] = 30 // terceira posição
    numeros[3] = 40 // quarta posição
    numeros[4] = 50 // quinta posição (última)

    escreva(numeros[0], "\n") // imgrime 0
    escreva(numeros[1], "\n") // imgrime 10
    escreva(numeros[2], "\n") // imgrime 20
    escreva(numeros[3], "\n") // imgrime 30
    escreva(numeros[4], "\n") // imgrime 40
    escreva(numeros[5], "\n") // imgrime 50
  }
}
