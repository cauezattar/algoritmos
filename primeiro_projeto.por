programa {
  funcao inicio() {
    //Declaraçao da variável
    cadeia nomeUsuario

    //ENTRADA: capturando dados do usuário
    escreva("Digite seu nome")
    leia(nomeUsuario)

    //SAÍDA: exibindo o resultado
    escreva("Olá, ",nomeUsuario,"!")
  }
}
